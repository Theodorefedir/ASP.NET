@using less1.ViewModels
@model ProductUpdatePageVM

@{
    ViewData["Title"] = "Update Product";
}

<div>
    <h2 class="text-center">Product editing</h2>
    <form method="post"
          enctype="multipart/form-data"
          asp-controller="Product"
          asp-action="Update"
          class="m-auto border p-5 rounded-2 mt-3"
          style="width: 35%;">

        <input type="hidden" asp-for="Product.Id" />

        @* Name *@
        <div>
            <label for="name" class="form-label">Name</label>
            <input asp-for="Product.Name" class="form-control" id="name">
            <span asp-validation-for="Product.Name" class="form-text text-danger"></span>
        </div>

        @* Price *@
        <div class="mt-4">
            <label for="price" class="form-label">Price</label>
            <input asp-for="Product.Price" type="number" step="0.01" class="form-control" id="price">
            <span asp-validation-for="Product.Price" class="form-text text-danger"></span>
        </div>

        @* Description *@
        <div class="mt-4">
            <label for="description" class="form-label">Description</label>
            <input asp-for="Product.Description" class="form-control" id="description">
        </div>

        @* Category *@
        <div class="mt-4">
            <label for="category" class="form-label">Category</label>
            <select asp-for="Product.CategoryId"
                    asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"
                    class="form-select"
                    id="category">
                <option value="">-- Select category --</option>
            </select>
            <span asp-validation-for="Product.CategoryId" class="form-text text-danger"></span>
        </div>

        @* Image *@
        <div class="mt-4">
            <label for="image" class="form-label">Image</label>
            <input asp-for="Product.Image" type="file" accept="image/*" class="form-control" id="image">
        </div>

        <div class="mt-4 w-50 m-auto">
            <input type="submit" class="btn btn-success w-100" value="Save" />
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
