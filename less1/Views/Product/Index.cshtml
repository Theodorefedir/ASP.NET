@using less1.ViewModels
@model IEnumerable<Product>
@{
    ViewData["Title"] = "Список товарів";
}

<div class="row">
    <div class="my-3 col-2 px-5 d-flex flex-column">
        <a asp-action="Index">All products</a>
    </div>
    <div class="col-10 pe-5">
        <table class="table table-striped my-3">
            <thead>
                <tr>
                    <th scope="col" class="text-center">Id</th>
                    <th scope="col" class="text-center">Image</th>
                    <th scope="col" class="text-center">Name</th>
                    <th scope="col" class="text-center">Price</th>
                    <th scope="col" class="text-center">Category</th>
                    <th scope="col" class="text-center">+</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <th class="text-center" scope="row">@product.Id</th>
                        <td class="text-center">
                            <img width="100"
                                 height="75"
                                 src="~/images/products/@(product.Image != null ? product.Image : "default.png")"
                                 alr="@product.Name" />
                        </td>
                        <td class="text-center">@product.Name</td>
                        <td class="text-center">@product.Price</td>
                        <td class="text-center">@(product.Category != null ? product.Category.Name : "No category")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary btn-sm">
                                    More
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
    </div>
</div>