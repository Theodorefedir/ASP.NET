@using less1.ViewModels
@model IEnumerable<CartVM>
@{
    ViewData["Title"] = "Cart";

    var totalCount = Model.Sum(i => i.Count);
    var subTotal = Model.Sum(i => i.Product!.Price * i.Count);
    var total = subTotal;
}

<main class="bg-light min-vh-100 py-5">
    <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-cart3 display-3"></i>
                <div>
                    <h1 class="display-4 fw-bold mb-0">Cart</h1>
                    <p class="text-secondary fs-5 mb-0">
                        Review your selected items and place your order
                    </p>
                </div>
            </div>

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-primary d-none d-md-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-5 text-center">
                    <i class="bi bi-cart-x display-1 text-secondary"></i>
                    <h3 class="fw-bold mt-3">Your cart is empty</h3>
                    <p class="text-secondary">Add some products to see them here.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg mt-2">
                        Browse products
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">

                <!-- Cart items -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <div class="row border-bottom pb-3 text-secondary fw-semibold d-none d-md-flex">
                                <div class="col-md-5">Product</div>
                                <div class="col-md-2 text-center">Price</div>
                                <div class="col-md-2 text-center">Quantity</div>
                                <div class="col-md-2 text-center">Total</div>
                                <div class="col-md-1"></div>
                            </div>

                            @foreach (var item in Model)
                            {
                                <div class="row align-items-center py-4 border-bottom gy-3">
                                    <div class="col-md-5">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="~/images/products/@(string.IsNullOrWhiteSpace(item.Product!.Image) ? "default.jpg" : item.Product!.Image)"
                                                 class="rounded-3 bg-light p-2"
                                                 width="100" height="100"
                                                 alt="@item.Product!.Name" />
                                            <div>
                                                <a href="#" class="text-dark text-decoration-none fw-bold">
                                                    @item.Product!.Name
                                                </a>
                                                <div class="text-secondary small mt-1">
                                                    @item.Product!.Category?.Name
                                                </div>
                                                <div class="text-success small fw-semibold mt-2">
                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                    In Stock
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-2 text-md-center">
                                        <span class="fw-semibold">@item.Product.Price ₴</span>
                                    </div>

                                    <div class="col-6 col-md-2">
                                        <div class="input-group input-group-sm">
                                            <a asp-action="Decrease" asp-route-productId="@item.Product.Id"
                                               class="btn btn-outline-secondary">
                                                <i class="bi bi-dash"></i>
                                            </a>

                                            <input type="text" value="@item.Count"
                                                   class="form-control text-center" readonly />

                                            <a asp-action="Increase" asp-route-productId="@item.Product.Id"
                                               class="btn btn-outline-secondary">
                                                <i class="bi bi-plus"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="col-10 col-md-2 text-md-center">
                                        <span class="fw-bold">@(item.Product!.Price * item.Count) ₴</span>
                                    </div>

                                    <div class="col-1 col-md-1 text-end">
                                        <a asp-action="Remove" asp-route-productId="@item.Product.Id"
                                           class="btn btn-link text-secondary p-0">
                                            <i class="bi bi-x-lg fs-5"></i>
                                        </a>
                                    </div>
                                </div>
                            }

                            <div class="pt-3">
                                <a asp-action="Clear" asp-controller="Cart"
                                   class="btn btn-link text-primary text-decoration-none p-0">
                                    <i class="bi bi-trash me-2"></i>
                                    Clear Cart
                                </a>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Summary -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h3 class="fw-bold mb-4">Order Summary</h3>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-secondary">Items (@totalCount)</span>
                                <strong>@subTotal ₴</strong>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-secondary">Discount</span>
                                <strong class="text-success">0 ₴</strong>
                            </div>

                            <div class="d-flex justify-content-between mb-4">
                                <span class="text-secondary">Delivery</span>
                                <strong class="text-success">Free</strong>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center my-4">
                                <span class="fs-5 fw-bold">Total</span>
                                <span class="fs-3 fw-bold">@total ₴</span>
                            </div>

                            <a asp-action="Checkout"
                               class="btn btn-primary btn-lg w-100 mb-3">
                                Place Order
                                <i class="bi bi-arrow-right ms-2"></i>
                            </a>

                            <button class="btn btn-light text-primary btn-lg w-100 mb-4" disabled>
                                Buy in 1 Click
                            </button>

                            <!-- Benefits -->
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                    <i class="bi bi-truck fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Free Delivery</div>
                                    <small class="text-secondary">on orders over 2000 ₴</small>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                    <i class="bi bi-shield-check fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">12-Month Warranty</div>
                                    <small class="text-secondary">on all products</small>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                    <i class="bi bi-arrow-repeat fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">14-Day Returns</div>
                                    <small class="text-secondary">no questions asked</small>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</main>