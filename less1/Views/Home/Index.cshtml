@using less1.ViewModels
@model HomeVM

@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="row justify-content-start">
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4">
                <partial model="@product" name="_ProductCard" />
            </div>
        }
    </div>
</div>
